rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Application: SyncUp
//
// Collection: sessions
// Document ID: {sessionId}
// Description: Represents public shared state for a collaborative session.
// Fields:
//   - status: string (e.g., 'active', 'ended')
//   - createdAt: timestamp
//   - hostId: string
//   - participants: list or map
//   - currentTopic / currentAgenda: string
//   [All mutations are performed exclusively through secure backend APIs using the Firebase Admin SDK]
//
// Subcollection: sessions/{sessionId}/private/{document=**}
// Description: Server-only session metadata, host secrets, tokens, or configuration.
// Access: Restricted to server/Admin SDK only.
//
// Subcollection: sessions/{sessionId}/auditLog/{eventId}
// Description: Immutable event log entries generated during session activity.
// Access: Restricted to server/Admin SDK only.
//
// Subcollection: sessions/{sessionId}/nudges/{nudgeId}
// Description: Internal nudges, reminders, or triggers generated by background services.
// Access: Restricted to server/Admin SDK only.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    /// Checks if the incoming request is from an authenticated user (including anonymous auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Sessions collection
    match /sessions/{sessionId} {
      // Authenticated clients (including Firebase Anonymous Auth) can read an individual session by its ID
      allow get: if isAuthenticated();

      // Explicitly disallow querying/listing the collection to prevent enumeration attacks
      allow list: if false;

      // Direct client mutations are strictly forbidden; all state changes must go through backend API routes / Admin SDK
      allow write: if false;

      // Server-only private configuration and secrets
      match /private/{document=**} {
        allow read, write: if false;
      }

      // Server-only audit event logging
      match /auditLog/{eventId} {
        allow read, write: if false;
      }

      // Server-only nudges tracking
      match /nudges/{nudgeId} {
        allow read, write: if false;
      }
    }

    // Default catch-all: Deny all reads and writes to any unmapped document or collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
